{
  "ConnectionStrings": {
    "SpeedyShopSqlite": "Data Source=App_Data/speedyshop.db",
    "SpeedyShopSqlServer": "Server=localhost,1433;Database=SpeedyShop;User Id=sa;Password=Your_strong_password123;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Database": {
    "Provider": "Sqlite",
    "CreateOnStartup": true
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  },
  "Seed": {
    "RunOnStartup": true,
    "Products": 50000,
    "Reviews": 500000,
    "Orders": 100000,
    "Customers": 20000,
    "BatchSize": 2000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
